#!/bin/bash
set -euo pipefail
umask 077

: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}"
: "${VESSEL_DISPLAY_SOCKET:?VESSEL_DISPLAY_SOCKET is required}"

uid_now="$(id -u)"
if [[ "$uid_now" == 0 ]]; then
  echo "Vessel desktop refuses to run as guest uid 0" >&2
  exit 71
fi

install -d -m 0700 "$XDG_RUNTIME_DIR"
install -d -m 0700 "$XDG_RUNTIME_DIR/vessel"
install -d -m 01777 /tmp/.X11-unix
rm -f "$XDG_RUNTIME_DIR"/wayland-* "$XDG_RUNTIME_DIR"/plasma-* 2>/dev/null || true
rm -f   "$XDG_RUNTIME_DIR/vessel/plasma-ready"   "$XDG_RUNTIME_DIR/vessel/plasma-ready-timeout"   "$XDG_RUNTIME_DIR/vessel/session-bus-address"   "$XDG_RUNTIME_DIR/vessel/plasma-watch.log" 2>/dev/null || true

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=KDE
export DESKTOP_SESSION=plasma
export QT_QPA_PLATFORM=wayland

# Resolve Qt/QML from the installed filesystem instead of assuming a Debian
# multiarch directory. The APK also supplies a discovered path, but the launcher
# independently validates it so rootfs upgrades and distro layout changes cannot
# strand Plasma behind a stale hardcoded path.
declare -a vessel_qml_roots=()
vessel_add_qml_root() {
  local root="${1%/}"
  [[ -n "$root" ]] || return 0
  [[ -s "$root/org/kde/plasma/core/qmldir" ]] || return 0
  [[ -s "$root/org/kde/plasma/core/libcorebindingsplugin.so" ]] || return 0
  [[ -s "$root/org/kde/ksvg/qmldir" ]] || return 0
  [[ -s "$root/org/kde/ksvg/libcorebindingsplugin.so" ]] || return 0
  local existing
  for existing in "${vessel_qml_roots[@]}"; do
    [[ "$existing" == "$root" ]] && return 0
  done
  vessel_qml_roots+=("$root")
}

if [[ -n "${QML_IMPORT_PATH:-}" ]]; then
  IFS=: read -r -a vessel_preseeded_qml <<<"$QML_IMPORT_PATH"
  for root in "${vessel_preseeded_qml[@]}"; do vessel_add_qml_root "$root"; done
fi

if [[ -s /var/cache/vessel/qml-import-path ]]; then
  IFS=: read -r -a vessel_cached_qml < /var/cache/vessel/qml-import-path || true
  for root in "${vessel_cached_qml[@]}"; do vessel_add_qml_root "$root"; done
fi

if [[ "${#vessel_qml_roots[@]}" -eq 0 ]]; then
  while IFS= read -r qmldir; do
    vessel_add_qml_root "${qmldir%/org/kde/plasma/core/qmldir}"
  done < <(
    find /usr/lib /usr/local/lib -type f \
      -path '*/qt6/qml/org/kde/plasma/core/qmldir' -print 2>/dev/null
  )
fi

if [[ "${#vessel_qml_roots[@]}" -eq 0 ]]; then
  echo "Vessel could not discover a complete Plasma 6 QML import root" >&2
  exit 74
fi

QML_IMPORT_PATH="$(IFS=:; printf '%s' "${vessel_qml_roots[*]}")"
export QML_IMPORT_PATH
export QML2_IMPORT_PATH="$QML_IMPORT_PATH"

declare -a vessel_plugin_roots=()
for root in "${vessel_qml_roots[@]}"; do
  plugin_root="${root%/qml}/plugins"
  [[ -d "$plugin_root" ]] && vessel_plugin_roots+=("$plugin_root")
done
if [[ "${#vessel_plugin_roots[@]}" -gt 0 ]]; then
  QT_PLUGIN_PATH="$(IFS=:; printf '%s' "${vessel_plugin_roots[*]}")"
  export QT_PLUGIN_PATH
fi
printf 'VESSEL_QML_IMPORT_PATH=%s\n' "$QML_IMPORT_PATH" >&2
printf 'VESSEL_QT_PLUGIN_PATH=%s\n' "${QT_PLUGIN_PATH:-}" >&2

export GDK_BACKEND=wayland,x11
export ANLAND_SOCKET="$VESSEL_DISPLAY_SOCKET"
export ANLAND=1
export ANLAND_NO_DRM_DEVICE=1
unset DISPLAY
unset EGL_PLATFORM

# Keep the normal Debian PATH. Prepending a directory that contains only
# KWin wrappers makes execvp() probe nonexistent wrapper/dbus-daemon,
# wrapper/startplasma-wayland, etc. Under coderredlab/proroot that failed-path
# probing can crash the bridge itself. KWin is wrapped surgically at
# /usr/bin/kwin_wayland_wrapper instead.
if [[ ! -s /etc/machine-id ]] && command -v dbus-uuidgen >/dev/null 2>&1; then
  dbus-uuidgen --ensure=/etc/machine-id
fi

if ! command -v dbus-run-session >/dev/null 2>&1; then
  echo "dbus-run-session is missing" >&2
  exit 72
fi
if ! command -v startplasma-wayland >/dev/null 2>&1; then
  echo "startplasma-wayland is missing" >&2
  exit 73
fi

# The readiness watcher runs inside the exact D-Bus session that owns Plasma.
# Do not discover plasmashell through /proc/pgrep: Android/proroot process
# identity is not a reliable Linux desktop liveness primitive.
exec dbus-run-session -- /bin/sh -c '
  set -eu
  install -d -m 0700 "$XDG_RUNTIME_DIR/vessel"
  printf "%s\n" "$DBUS_SESSION_BUS_ADDRESS" >"$XDG_RUNTIME_DIR/vessel/session-bus-address"
  chmod 0600 "$XDG_RUNTIME_DIR/vessel/session-bus-address"

  (
    i=0
    while [ "$i" -lt 600 ]; do
      if dbus-send --session           --dest=org.freedesktop.DBus           --type=method_call           --print-reply           /org/freedesktop/DBus org.freedesktop.DBus.NameHasOwner           string:org.kde.plasmashell 2>/dev/null           | grep -Fq "boolean true"; then
        tmp="$XDG_RUNTIME_DIR/vessel/.plasma-ready.$$"
        printf "org.kde.plasmashell\n" >"$tmp"
        chmod 0600 "$tmp"
        mv -f "$tmp" "$XDG_RUNTIME_DIR/vessel/plasma-ready"
        exit 0
      fi
      i=$((i + 1))
      sleep .1
    done
    printf "org.kde.plasmashell was not registered after 60s\n"       >"$XDG_RUNTIME_DIR/vessel/plasma-ready-timeout"
  ) >>"$XDG_RUNTIME_DIR/vessel/plasma-watch.log" 2>&1 &

  if command -v pulseaudio >/dev/null 2>&1; then
    pulseaudio --start --exit-idle-time=-1 >/dev/null 2>&1 || true
  fi
  exec startplasma-wayland
'
