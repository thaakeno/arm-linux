const float PI=3.14159265358979323846;const int STATIC_INSTANCES=20;struct Material{vec3 base;float metallic;float roughness;float clearcoat;float ao;vec3 emission;};
float hash21(vec2 p){p=fract(p*vec2(123.34,456.21));p+=dot(p,p+45.32);return fract(p.x*p.y);}float fbm2(vec2 p){float f=0.0,a=.56;for(int i=0;i<3;i++){f+=a*hash21(floor(p));p=p*2.03+17.1;a*=.47;}return f;}vec2 envUv(vec3 d){d=normalize(d);return vec2(atan(d.z,d.x)/(2.0*PI)+.5,acos(clamp(d.y,-1.0,1.0))/PI);}vec3 envSample(vec3 d,float lod){return textureLod(environmentMap,envUv(d),lod).rgb;}
vec3 skySample(vec3 d){d=normalize(d);float h=clamp(d.y*.5+.5,0.0,1.0),night=clamp((-pc.exposure-.45)/.72,0.0,1.0);vec3 day=mix(vec3(.79,.73,.62),vec3(.13,.30,.58),smoothstep(.06,.92,h));vec3 ns=mix(vec3(.020,.028,.046),vec3(.008,.020,.070),smoothstep(.04,.94,h));vec3 sunD=normalize(vec3(-.53,.67,.52));float sun=pow(max(dot(d,sunD),0.0),1200.0),glow=pow(max(dot(d,sunD),0.0),18.0);day+=vec3(9.0,6.0,3.2)*sun+vec3(.50,.27,.11)*glow;float stars=step(.9984,hash21(floor(envUv(d)*vec2(700.0,350.0))))*smoothstep(.56,.88,h)*night;ns+=vec3(stars)*1.8;vec3 c=mix(day,ns,night);float ground=smoothstep(.50,.43,h);return mix(c,mix(vec3(.14,.16,.13),vec3(.006,.010,.016),night),ground);}
vec3 fresnelSchlick(float c,vec3 F0){return F0+(1.0-F0)*pow(1.0-c,5.0);}float Dggx(float NoH,float r){float a=max(.028,r*r),a2=a*a,d=NoH*NoH*(a2-1.0)+1.0;return a2/max(PI*d*d,1e-5);}float Gsmith(float NoV,float NoL,float r){float k=(r+1.0)*(r+1.0)/8.0;return NoV/(NoV*(1.0-k)+k)*NoL/(NoL*(1.0-k)+k);}vec3 tangentNormal(sampler2D tex,vec2 uv,vec3 N,vec3 T,vec3 B,float strength){vec3 n=texture(tex,uv).xyz*2.0-1.0;n.xy*=strength;return normalize(mat3(normalize(T),normalize(B),normalize(N))*normalize(n));}
float waterCoverage(vec2 uv){float h=texture(floorHeight,fract(uv)).r,wet=clamp(pc.wetness,0.0,1.0),level=mix(.29,.76,wet);float basin=1.0-smoothstep(level-.095,level+.018,h);vec2 f=fract(uv);float edge=min(min(f.x,f.y),min(1.0-f.x,1.0-f.y));float joints=1.0-smoothstep(.014,.088,edge);return clamp(max(basin*(.76+.24*fbm2(uv*10.0)),joints*wet),0.0,1.0);}
Material materialAt(int m,vec3 P,vec2 uv,out float water){Material a;a.base=vec3(.5);a.metallic=0;a.roughness=.5;a.clearcoat=0;a.ao=1;a.emission=vec3(0);water=0;if(m==0){vec2 t=fract(uv*1.28);vec4 arm=texture(concreteArm,t);a.base=texture(concreteAlbedo,t).rgb;a.roughness=clamp(arm.g,.28,.92);a.ao=arm.r;}else if(m==1){vec2 t=fract(uv);vec4 arm=texture(floorArm,t);water=waterCoverage(t);vec3 dry=texture(floorAlbedo,t).rgb;float dirt=.86+.16*fbm2(t*23.0);a.base=dry*dirt*mix(1.0,.34,water*.98);a.roughness=mix(clamp(arm.g,.36,.94),.024,water);a.clearcoat=water;a.ao=arm.r;}else if(m==2){float grain=fbm2(uv*260.0),scratch=smoothstep(.952,.995,hash21(vec2(floor(uv.y*430.0),floor(uv.x*31.0))));float worn=.5+.5*sin((uv.x+uv.y)*18.0+fbm2(uv*52.0)*6.0);a.base=mix(vec3(.075,.085,.095),vec3(.26,.275,.29),grain*.38+worn*.09);a.base=mix(a.base,vec3(.48,.43,.34),scratch*.42);a.metallic=1.0;a.roughness=clamp(.18+grain*.24+scratch*.18,.16,.50);a.clearcoat=.04;}else if(m==3){float pores=fbm2(uv*220.0),scuff=smoothstep(.84,.98,fbm2(uv*31.0+9.0));a.base=mix(vec3(.35,.006,.006),vec3(.78,.020,.012),pores*.34);a.base*=1.0-scuff*.24;a.roughness=clamp(.66+pores*.18-scuff*.10,.56,.86);a.clearcoat=.012;a.ao=.95;}else if(m==4){float pulse=.94+.06*sin(pc.time*4.0);a.base=vec3(1.0,.54,.20);a.roughness=.12;a.clearcoat=.72;a.emission=vec3(7.8,3.55,1.12)*pulse;}else if(m==5){vec2 t=fract(uv*1.15);vec4 arm=texture(concreteArm,t);float stain=.72+.28*fbm2(P.xz*2.7+uv*8.0);a.base=texture(concreteAlbedo,t).rgb*vec3(.63,.59,.52)*stain;a.roughness=clamp(arm.g+.12,.58,.98);a.ao=arm.r;}else if(m==6){vec2 t=fract(uv*1.20);vec4 arm=texture(darkArm,t);a.base=texture(darkAlbedo,t).rgb*vec3(.22,.235,.25);a.roughness=clamp(arm.g*.82,.24,.80);a.ao=arm.r;}else if(m==7){float grain=fbm2(uv*190.0),scuff=smoothstep(.87,.99,fbm2(uv*29.0+4.0));a.base=mix(vec3(.040,.055,.065),vec3(.12,.16,.18),grain*.40);a.base*=1.0-scuff*.26;a.roughness=clamp(.72+grain*.16-scuff*.16,.58,.92);a.clearcoat=.008;a.ao=.94;}else if(m==8){float cell=fbm2(uv*110.0+P.xy*3.0),vein=fbm2(uv*27.0+vec2(8.0,3.0));a.base=mix(vec3(.025,.19,.055),vec3(.10,.54,.17),cell*.55);a.base*=.86+.18*vein;a.roughness=clamp(.29+.18*cell,.26,.50);a.clearcoat=.54;a.ao=.96;}else if(m==10){float n=hash21(floor(P.xz*15.0+P.yy*7.0));a.base=mix(vec3(.045,.13,.052),vec3(.12,.29,.10),n);a.roughness=.72;a.ao=.84;}else if(m==12){float stain=.68+.32*fbm2(P.xz*5.0+P.yy);a.base=vec3(.060,.068,.074)*stain;a.roughness=.82;a.metallic=.02;}else if(m==14){float grain=.5+.5*sin(uv.y*70.0+sin(uv.x*14.0)*2.0);a.base=mix(vec3(.12,.045,.018),vec3(.34,.15,.055),grain*.42);a.roughness=.62;}return a;}
vec3 materialNormal(int m,vec3 P,vec2 uv,vec3 N,vec3 T,vec3 B,float water){float q=clamp(pc.quality/100.0,0.0,1.0),detail=mix(.35,1.0,q);if(m==0)return tangentNormal(concreteNormal,fract(uv*1.28),N,T,B,.88*detail);if(m==1)return tangentNormal(floorNormal,fract(uv),N,T,B,mix(1.0,.18,water)*detail);if(m==6)return tangentNormal(darkNormal,fract(uv*1.20),N,T,B,.78*detail);if(m==2||m==3||m==7||m==8){float n1=fbm2(uv*190.0)-.5,n2=fbm2(uv.yx*233.0+11.0)-.5;float amp=m==2?.038:(m==8?.018:(m==3?.025:.030));return normalize(N+(T*n1+B*n2)*amp*detail);}return normalize(N);}
vec3 brdf(Material m,vec3 N,vec3 V,vec3 L,vec3 radiance){float NoL=max(dot(N,L),0.0),NoV=max(dot(N,V),.001);if(NoL<=0)return vec3(0);vec3 H=normalize(V+L);float NoH=max(dot(N,H),0.0),VoH=max(dot(V,H),0.0);vec3 F0=mix(vec3(.04),m.base,m.metallic),F=fresnelSchlick(VoH,F0);vec3 spec=Dggx(NoH,m.roughness)*Gsmith(NoV,NoL,m.roughness)*F/max(4.0*NoV*NoL,.001);vec3 kd=(1.0-F)*(1.0-m.metallic);return (kd*m.base/PI+spec)*NoL*radiance;}vec3 envSpec(vec3 R,float rough){return mix(skySample(R),envSample(R,mix(.7,7.0,rough)),.18)*mix(1.08,.58,rough);}vec3 ibl(Material m,vec3 N,vec3 V){vec3 R=reflect(-V,N),F0=mix(vec3(.04),m.base,m.metallic),F=fresnelSchlick(max(dot(N,V),0.0),F0);vec3 diff=mix(vec3(.78,.86,.95),envSample(N,8.0),.13)*m.base*(1.0-m.metallic)*(.34*m.ao);vec3 spec=envSpec(R,m.roughness)*F;if(m.clearcoat>0)spec+=envSpec(R,max(.025,m.roughness*.55))*fresnelSchlick(max(dot(N,V),0.0),vec3(.04))*m.clearcoat*.58;return diff+spec;}vec3 aces(vec3 x){x*=exp2(pc.exposure);const float a=2.51,b=.03,c=2.43,d=.59,e=.14;return clamp((x*(a*x+b))/(x*(c*x+d)+e),0.0,1.0);}
void main(){if(inMaterial==13){outColor=vec4(pow(aces(skySample(normalize(inWorldPos-inCameraPos))),vec3(1.0/2.2)),1);return;}float water;Material m=materialAt(inMaterial,inWorldPos,inUv,water);vec3 V=normalize(inCameraPos-inWorldPos),T=normalize(inTangent),B=normalize(inBitangent),geomN=normalize(inWorldNormal);if(dot(geomN,V)<0.0)geomN=-geomN;vec3 N=materialNormal(inMaterial,inWorldPos,inUv,geomN,T,B,water);vec3 lightRgb=max(bodies[2].extra.yzw,vec3(.05));if(inMaterial==4&&inObject==STATIC_INSTANCES+2){float pulse=.94+.06*sin(pc.time*4.0);m.base=lightRgb;m.emission=lightRgb*8.2*pulse;m.roughness=.10;m.clearcoat=.75;}if(length(m.emission)>0){float rim=pow(1.0-max(dot(N,V),0.0),2.0);outColor=vec4(pow(aces(m.emission+m.base*(.22+rim*1.1)),vec3(1.0/2.2)),1);return;}vec3 sunL=normalize(vec3(-.53,.67,.52));float night=clamp((-pc.exposure-.45)/.72,0.0,1.0);vec3 color=ibl(m,N,V)+brdf(m,N,V,sunL,vec3(2.25,1.78,1.30)*(1.0-night*.82));vec3 d=bodies[2].posRad.xyz-inWorldPos;color+=brdf(m,N,V,normalize(d),lightRgb*(27.0/max(dot(d,d),.34)));if(inMaterial==3){float rim=pow(1.0-max(dot(N,V),0.0),2.0);color+=m.base*vec3(.80,.09,.07)*rim*.10;}if(inMaterial==8){float rim=pow(1.0-max(dot(N,V),0.0),2.3);color+=m.base*vec3(.32,.95,.40)*rim*.20;}if(inMaterial==1&&water>.01){vec3 R=reflect(-V,N);float f=.06+.42*pow(1.0-max(dot(N,V),0.0),5.0);color=mix(color,envSpec(R,mix(.018,.11,1.0-water)),clamp(water*(.28+f),0.0,.72));}outColor=vec4(pow(aces(max(color,vec3(0))),vec3(1.0/2.2)),1);}